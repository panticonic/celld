+/* dolt_pack_fetch(remote, pack): fetch every branch the pack carries into the
+** remote-tracking branches remote/<branch>, exactly as dolt_fetch does from
+** a remote that holds the pack's chunks. Answers "branch hash" lines. Run it
+** in autocommit, as dolt_fetch. */
+static void celldPackFetchFunc(
+  sqlite3_context *ctx,
+  int argc,
+  sqlite3_value **argv
+){
+  sqlite3 *db = sqlite3_context_db_handle(ctx);
+  ChunkStore *cs = doltliteGetChunkStore(db);
+  DoltliteRemote *pRemote = 0;
+  const char *zRemote;
+  const u8 *pBlob;
+  int nBlob;
+  char **azNames = 0;
+  int nNames = 0;
+  CelldPackOut out;
+  int rc;
+  int i;
+  (void)argc;
+
+  if( !cs ){
+    doltliteVcResultError(ctx, db, "no database");
+    return;
+  }
+  zRemote = (const char*)sqlite3_value_text(argv[0]);
+  pBlob = (const u8*)sqlite3_value_blob(argv[1]);
+  nBlob = sqlite3_value_bytes(argv[1]);
+  if( !zRemote || !zRemote[0] ){
+    doltliteVcResultError(ctx, db, "dolt_pack_fetch needs a remote name");
+    return;
+  }
+  memset(&out, 0, sizeof(out));
+  rc = celldPackOpen(pBlob, nBlob, &pRemote);
+  if( rc!=SQLITE_OK ){
+    (void)doltliteVcSealSavepointError(db);
+    remoteSqlResultError(ctx, rc,
+        rc==SQLITE_NOMEM ? 0 : "dolt_pack_fetch: not a pack");
+    return;
+  }
+  rc = parseRemoteBranchNames(pRemote, &azNames, &nNames);
+  for(i=0; i<nNames && rc==SQLITE_OK; i++){
+    int missing = 0;
+    rc = doltliteFetchInto(cs, pRemote, zRemote, azNames[i], azNames[i],
+                           &missing);
+    if( rc==SQLITE_OK ){
+      ProllyHash h;
+      char zHex[PROLLY_HASH_SIZE*2+1];
+      if( chunkStoreFindTracking(cs, zRemote, azNames[i], &h)==SQLITE_OK ){
+        doltliteHashToHex(&h, zHex);
+        rc = celldPackAppend(&out, azNames[i], (i64)strlen(azNames[i]));
+        if( rc==SQLITE_OK ) rc = celldPackAppend(&out, " ", 1);
+        if( rc==SQLITE_OK ) rc = celldPackAppend(&out, zHex, PROLLY_HASH_SIZE*2);
+        if( rc==SQLITE_OK ) rc = celldPackAppend(&out, "\n", 1);
+      }
+    }
+  }
+  if( rc!=SQLITE_OK ){
+    const char *zMsg = pRemote->zMissingChunkError[0]
+        ? pRemote->zMissingChunkError : "dolt_pack_fetch: fetch failed";
+    char *zOwned = sqlite3_mprintf("%s", zMsg);
+    (void)doltliteVcSealSavepointError(db);
+    remoteSqlResultError(ctx, rc, zOwned);
+    sqlite3_free(zOwned);
+  }else{
+    sqlite3_result_text64(ctx, (const char*)out.p, (sqlite3_uint64)out.n,
+                          SQLITE_TRANSIENT, SQLITE_UTF8);
+  }
+  pRemote->xClose(pRemote);
+  doltliteFreeStringArray(azNames, nNames);
+  doltliteNoteSessionMissedDiskTip(db);
+  sqlite3_free(out.p);
+}
