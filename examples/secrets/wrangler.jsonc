{
  "name": "secrets",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "VAULT", "class_name": "Vault" },
      { "name": "OTHER", "class_name": "Other" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vault", "Other"] }],
  // Visible to everything in this Worker, and in the deployment manifest.
  "vars": { "PUBLIC": "visible-to-all" },
  // API_TOKEN is a secret of the class `Vault` alone. Its value is not in this
  // file or in the deployment: `celld secret put secrets API_TOKEN` stores it,
  // sealed, in the fleet bucket. Under `celld dev` it is read from `.env` (or
  // `.dev.vars`) and kept out of `vars`.
  "celld": { "durable_objects": { "Vault": { "secrets": ["API_TOKEN"] } } }
}
