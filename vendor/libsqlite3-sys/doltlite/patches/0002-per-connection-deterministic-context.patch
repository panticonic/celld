 /************** End of doltlite_http_remote.c ********************************/
 /************** doltlite: END prolly engine + version-control layer **********/
+
+/************** celld: per-connection deterministic context ******************/
+/*
+** A connection's DetCtx holds the three engine inputs that Chronolog Spec 10
+** pins per transaction: the clock, the PRNG and the timezone. It hangs off
+** sqlite3.pDetCtx, is only read by the owning connection (under its mutex)
+** and is freed at close, so concurrent connections never see each other's
+** context. This replaces the process-global approach (a default-VFS wrapper,
+** SQLITE_TESTCTRL_PRNG_SEED and SQLITE_TESTCTRL_LOCALTIME_FAULT).
+*/
+struct DetCtx {
+  sqlite3_int64 iJulianMs;    /* Julian day number in ms, as the VFS clock */
+  unsigned int flags;         /* SQLITE_DOLTLITE_DET_* */
+  u32 s[16];                  /* ChaCha20 state, same layout as random.c */
+  u8 out[64];                 /* Output bytes */
+  u8 n;                       /* Output bytes remaining */
+};
+
+#define DET_UNIX_TO_JULIAN_MS 210866760000000LL
+#define DET_MAX_UNIX_MS 253402300799999LL
+#define DET_KNOWN_FLAGS (SQLITE_DOLTLITE_DET_UTC_LOCALTIME \
+                        |SQLITE_DOLTLITE_DET_RESET_COUNTERS)
+
+/* Seed the private ChaCha20 stream exactly as random.c seeds the global one
+** under SQLITE_TESTCTRL_PRNG_SEED: key words 0 and 1 carry the seed (the
+** low 32 bits first), everything else is zero. A seed below 2^32 therefore
+** yields the same stream as the Chronolog 0.11.29 addon. */
+static void detPrngSeed(DetCtx *p, sqlite3_uint64 seed){
+  static const u32 chacha20_init[] = {
+    0x61707865, 0x3320646e, 0x79622d32, 0x6b206574
+  };
+  memset(p->s, 0, sizeof(p->s));
+  memcpy(&p->s[0], chacha20_init, 16);
+  p->s[4] = (u32)(seed & 0xffffffffu);
+  p->s[5] = (u32)(seed >> 32);
+  p->n = 0;
+}
+
+SQLITE_API int sqlite3_doltlite_set_det_context(
+  sqlite3 *db,
+  sqlite3_int64 unixMs,
+  sqlite3_uint64 seed,
+  unsigned int flags
+){
+  DetCtx *p;
+  if( db==0 || (flags & ~(unsigned int)DET_KNOWN_FLAGS)!=0 ) return SQLITE_MISUSE;
+  if( unixMs<0 || unixMs>DET_MAX_UNIX_MS ) return SQLITE_RANGE;
+  sqlite3_mutex_enter(db->mutex);
+  p = db->pDetCtx;
+  if( p==0 ){
+    p = (DetCtx*)sqlite3_malloc64(sizeof(*p));
+    if( p==0 ){
+      sqlite3_mutex_leave(db->mutex);
+      return SQLITE_NOMEM;
+    }
+    db->pDetCtx = p;
+  }
+  memset(p, 0, sizeof(*p));
+  p->iJulianMs = unixMs + DET_UNIX_TO_JULIAN_MS;
+  p->flags = flags;
+  detPrngSeed(p, seed);
+  if( flags & SQLITE_DOLTLITE_DET_RESET_COUNTERS ){
+    db->lastRowid = 0;
+    db->nChange = 0;
+  }
+  sqlite3_mutex_leave(db->mutex);
+  return SQLITE_OK;
+}
+
+SQLITE_API int sqlite3_doltlite_clear_det_context(sqlite3 *db){
+  if( db==0 ) return SQLITE_MISUSE;
+  sqlite3_mutex_enter(db->mutex);
+  sqlite3DetCtxFree(db);
+  sqlite3_mutex_leave(db->mutex);
+  return SQLITE_OK;
+}
+
+SQLITE_API int sqlite3_doltlite_det_context_active(sqlite3 *db){
+  return db!=0 && db->pDetCtx!=0;
+}
+
+SQLITE_PRIVATE void sqlite3DetCtxFree(sqlite3 *db){
+  DetCtx *p = db->pDetCtx;
+  if( p ){
+    db->pDetCtx = 0;
+    memset(p, 0, sizeof(*p));
+    sqlite3_free(p);
+  }
+}
+
+/* Open-time pinning for a new store's genesis commit. Returns 1 when a
+** context was installed (the caller clears it once the store is seeded). */
+SQLITE_PRIVATE int sqlite3DetCtxFromUri(sqlite3 *db, const char *zFilename){
+  const char *zMs;
+  const char *zSeed;
+  sqlite3_int64 ms = 0;
+  sqlite3_uint64 seed = 0;
+  if( zFilename==0 ) return 0;
+  zMs = sqlite3_uri_parameter(zFilename, "doltlite_det_ms");
+  if( zMs==0 || zMs[0]==0 ) return 0;
+  zSeed = sqlite3_uri_parameter(zFilename, "doltlite_det_seed");
+  if( sqlite3Atoi64(zMs, &ms, sqlite3Strlen30(zMs), SQLITE_UTF8)!=SQLITE_OK ){
+    return 0;
+  }
+  if( zSeed ){
+    sqlite3_int64 s2 = 0;
+    if( sqlite3Atoi64(zSeed, &s2, sqlite3Strlen30(zSeed), SQLITE_UTF8)==SQLITE_OK ){
+      seed = (sqlite3_uint64)s2;
+    }
+  }
+  return sqlite3_doltlite_set_det_context(db, ms, seed,
+                                SQLITE_DOLTLITE_DET_UTC_LOCALTIME)==SQLITE_OK;
+}
+
+/* The connection clock: the pinned time while a context is set, otherwise
+** the VFS clock. Every date function and every Dolt timestamp goes here. */
+SQLITE_PRIVATE int sqlite3DbCurrentTimeInt64(sqlite3 *db, sqlite3_int64 *pTime){
+  if( db->pDetCtx ){
+    *pTime = db->pDetCtx->iJulianMs;
+    return SQLITE_OK;
+  }
+  return sqlite3OsCurrentTimeInt64(db->pVfs, pTime);
+}
+
+SQLITE_PRIVATE int sqlite3DbDetUtc(sqlite3 *db){
+  return db!=0 && db->pDetCtx!=0
+      && (db->pDetCtx->flags & SQLITE_DOLTLITE_DET_UTC_LOCALTIME)!=0;
+}
+
+/* sqlite3_randomness() for code that has a connection: the private stream
+** while a context is set, the global PRNG otherwise. */
+SQLITE_PRIVATE void sqlite3DbRandomness(sqlite3 *db, int N, void *pBuf){
+  DetCtx *p = db ? db->pDetCtx : 0;
+  unsigned char *zBuf = (unsigned char*)pBuf;
+  if( p==0 || N<=0 || pBuf==0 ){
+    sqlite3_randomness(N, pBuf);
+    return;
+  }
+  while( 1 /* exit by break */ ){
+    if( N<=p->n ){
+      memcpy(zBuf, &p->out[p->n-N], N);
+      p->n -= N;
+      break;
+    }
+    if( p->n>0 ){
+      memcpy(zBuf, p->out, p->n);
+      N -= p->n;
+      zBuf += p->n;
+    }
+    p->s[12]++;
+    chacha_block((u32*)p->out, p->s);
+    p->n = 64;
+  }
+}
