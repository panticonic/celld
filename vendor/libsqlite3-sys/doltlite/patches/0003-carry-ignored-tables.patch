+/* celld: the tables checkout carries. Runs while the session still holds
+** the branch being left, because dolt_ignore is read through it. These are
+** the tables the branch does not track and dolt_ignore covers (the split
+** the pull path makes, mergeSplitWorkingCatalog), named so that
+** mergeCopyLocalTables can move them by name. */
+static int checkoutCarryFind(sqlite3 *db, CheckoutMutationCtx *p){
+  ProllyHash headCat, tracked, ignored;
+  struct TableEntry *aIgnored = 0;
+  int nIgnored = 0;
+  char *zErr = 0;
+  int i, rc;
+  doltliteFreeCatalog(p->aCarry, p->nCarry);
+  p->aCarry = 0;
+  p->nCarry = 0;
+  if( !p->bCarryIgnored || !p->haveOldState || p->savedWasDetached
+   || p->oldBranchMissing || prollyHashIsEmpty(&p->oldCommitHash) ){
+    return SQLITE_OK;
+  }
+  rc = doltliteCommitCatalogHash(db, &p->oldCommitHash, &headCat);
+  if( rc==SQLITE_OK ){
+    rc = mergeSplitWorkingCatalog(db, &headCat, &headCat, 0,
+                                  &tracked, &ignored, &zErr);
+  }
+  sqlite3_free(zErr);
+  if( rc!=SQLITE_OK || prollyHashIsEmpty(&ignored) ) return rc;
+  rc = doltliteLoadCatalog(db, &ignored, &aIgnored, &nIgnored, 0);
+  if( rc!=SQLITE_OK ) return rc;
+  p->aCarry = sqlite3_malloc64(((sqlite3_uint64)nIgnored+1)*sizeof(*p->aCarry));
+  if( !p->aCarry ){
+    doltliteFreeCatalog(aIgnored, nIgnored);
+    return SQLITE_NOMEM;
+  }
+  for(i=0; i<nIgnored; i++){
+    if( aIgnored[i].iTable<=1 || !aIgnored[i].zName
+     || strcmp(aIgnored[i].zName, "sqlite_sequence")==0 ) continue;
+    memset(&p->aCarry[p->nCarry], 0, sizeof(p->aCarry[0]));
+    p->aCarry[p->nCarry].zName = sqlite3_mprintf("%s", aIgnored[i].zName);
+    if( !p->aCarry[p->nCarry].zName ){
+      rc = SQLITE_NOMEM;
+      break;
+    }
+    p->nCarry++;
+  }
+  doltliteFreeCatalog(aIgnored, nIgnored);
+  if( rc!=SQLITE_OK ){
+    doltliteFreeCatalog(p->aCarry, p->nCarry);
+    p->aCarry = 0;
+    p->nCarry = 0;
+  }
+  return rc;
+}
+
+/* celld: graft the carried tables onto the target's working catalog. A table
+** of the same name the target already holds (its copy from an earlier visit)
+** is replaced. */
+static int checkoutCarryApply(sqlite3 *db, CheckoutMutationCtx *p){
+  ProllyHash grafted;
+  char *zErr = 0;
+  int rc;
+  if( p->nCarry<=0 ) return SQLITE_OK;
+  rc = mergeCopyLocalTables(db, &p->oldCatHash, &p->targetCatHash,
+                            p->aCarry, p->nCarry, &grafted, &zErr);
+  sqlite3_free(zErr);
+  if( rc!=SQLITE_OK ) return rc;
+  rc = doltliteSwitchCatalog(db, &grafted);
+  if( rc==SQLITE_OK ){
+    p->targetCatHash = grafted;
+    sqlite3VtabRollback(db);
+  }
+  return rc;
+}
