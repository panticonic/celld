{
  "name": "dolt-facets",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [{ "name": "SUPERVISOR", "class_name": "Supervisor" }]
  },
  // The supervisor is an ordinary SQLite class; its workspaces are Dolt
  // facets, chosen per facet in ctx.facets.get(..., () => ({ class,
  // celld: { storage: "dolt" } })).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Supervisor"] }]
}
